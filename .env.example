# Rename to .env and fill in any keys your solution needs.
# We have accounts with these providers and will supply real keys when reviewing.

ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx
ELEVEN_LABS_API_KEY=xxxxx
GOOGLE_CLOUD_API_KEY=xxxxx
AWS_ACCESS_KEY_ID=xxxxx
AWS_SECRET_ACCESS_KEY=xxxxx
AWS_REGION=us-west-2

# Formbricks secrets (generate each with: openssl rand -hex 32)
NEXTAUTH_SECRET=replace-me
ENCRYPTION_KEY=replace-me
CRON_SECRET=replace-me

# Vercel deployment
VERCEL_TOKEN=xxxxx
VERCEL_ORG_ID=xxxxx
VERCEL_PROJECT_ID=xxxxx

# Neon database
NEON_API_KEY=xxxxx
NEON_PROJECT_ID=xxxxx
DATABASE_URL=postgresql://user:pass@host/formbricks?sslmode=require
